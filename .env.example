# ----------------------------------------------------------------------------
# THE BIG SISTER - ENVIRONMENT CONFIGURATION
# ----------------------------------------------------------------------------

# OPTION 1: OPENROUTER (Recommended if using OpenRouter's Gemini endpoints)
# Set your OpenRouter API key below.
# The adapter will automatically route all chat requests to OpenRouter.
# Note: If your key starts with 'sk-or-', you can also set it as GEMINI_API_KEY.
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: Choose which Gemini model to use on OpenRouter (defaults to google/gemini-2.5-flash)
# Examples: "google/gemini-2.5-flash", "google/gemini-flash-1.5", "google/gemini-2.0-flash-001"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# ----------------------------------------------------------------------------
# OPTION 2: GOOGLE GEMINI NATIVE API KEY
# If not using OpenRouter, you can use Google's native Gemini API key here.
# (Acquired from Google AI Studio at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx"

# ----------------------------------------------------------------------------
# APP URL (Used for self-referential links, OpenRouter HTTP-Referer header, etc.)
APP_URL="https://the-big-sister.vercel.app"
